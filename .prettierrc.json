{
    "$schema": "http://json.schemastore.org/prettierrc",
    "tabWidth": 4,
    "plugins": [
        "@ianvs/prettier-plugin-sort-imports",
        "prettier-plugin-svelte",
        "prettier-plugin-tailwindcss"
    ],
    "importOrder": [
        "(^\\$app)|(^svelte(\\/.*)?$)",
        "<BUILTIN_MODULES>",
        "",
        "^carbon-",
        "<THIRD_PARTY_MODULES>",
        "",
        "^\\$(lib|components|routes)",
        "^[.]"
    ],
    "tailwindFunctions": ["cn"],
    "printWidth": 100,
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": "*.svelte",
            "options": {
                "parser": "svelte"
            }
        }
    ]
}
