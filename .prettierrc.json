{
    "$schema": "http://json.schemastore.org/prettierrc",
    "tabWidth": 4,
    "plugins": ["prettier-plugin-organize-imports", "prettier-plugin-tailwindcss"],
    "tailwindStylesheet": "app/style/main.css",
    "tailwindFunctions": ["cn"],
    "printWidth": 100,
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
