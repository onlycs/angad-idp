{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            u.id,\n            u.email,\n            u.username,\n            COALESCE(\n                JSONB_AGG(\n                    JSONB_BUILD_OBJECT(\n                        'slug', r.application,\n                        'admin', r.admin\n                    )\n                ),\n                '[]'::jsonb\n            ) AS \"roles!: sqlx::types::Json<Vec<Membership>>\"\n        FROM users u\n        LEFT JOIN roles r ON r.uid = u.id\n        GROUP BY u.id;\n        ",
