// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
    "tab_size": 4,
    "languages": {
        "TypeScript": {
            "formatter": "prettier",
        },
        "Vue.js": {
            "formatter": "prettier",
        },
        "CSS": {
            "language_servers": ["tailwindcss-intellisense-css", "!vscode-css-language-server"],
            "formatter": "prettier",
        },
        "Markdown": {
            "formatter": "prettier",
        },
        "YAML": {
            "formatter": "prettier",
            "tab_size": 2,
        },
        "SQL": {
            "tab_size": 4,
        },
        "Proto": {
            "tab_size": 2,
        },
        "Apache Avro (IDL)": {
            "tab_size": 2,
        },
    },
    "lsp": {
        "tailwindcss-language-server": {
            "settings": {
                "includeLanguages": {
                    "vue": "html",
                },
                "classFunctions": ["cn"],
                "experimental": {
                    "classRegex": [
                        "class=\"([^\"]*)\"",
                        "class='([^']*)'",
                        ":class=\"([^\"]*)\"",
                        ":class='([^']*)'",
                    ],
                },
            },
        },
        "rust-analyzer": {
            "initialization_options": {
                "check": {
                    "command": "clippy",
                },
                "cargo": {
                    "allFeatures": true,
                    // "target": "wasm32-unknown-unknown",
                },
            },
        },
    },
}
